#!name=南门DNS Trigger 合成模块
#!desc=cron / network-changed / generic 三种触发脚本与非法 cron 拒绝
#!author=南门DNS
#!category=测试
#!date=2026-11-23

[Script]
cron "0 9 * * *" script-path=https://scripts.example.com/checkin.js, timeout=10, tag=签到
cron "61 9 * * *" script-path=https://scripts.example.com/bad.js, tag=非法分钟
network-changed script-path=https://scripts.example.com/net.js, tag=切网
generic script-path=https://scripts.example.com/manual.js, tag=手动
